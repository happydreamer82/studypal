{
  "manifest_version": 3,
  "name": "StudyPal",
  "version": "0.1.0",
  "description": "Stellt Fragen zur aktuellen Webseite und zeigt die Antwort des lokalen Modells in einem Panel rechts auf der Seite an.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:4000/*"],
  "action": {
    "default_title": "StudyPal: Panel oeffnen/schliessen",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
